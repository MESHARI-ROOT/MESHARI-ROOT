{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meshari-alotaibi",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/__bootstrap/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ZEN_STORE",
        "class_name": "ZenStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ZenStore"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "0 3 * * *"
    ]
  }
}
